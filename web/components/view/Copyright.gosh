<!-- @server ./system/logic/universal_components.go#UniversalComponentData -->
<template>
	<div :id="id" :class="class" data-view-copyright>
		<span class="copyright-text"
			>© <span data-view-copyright-year>{{ startYear }}</span>
			{{ owner }}.</span
		><span m-if="allRightsReserved" class="rights-text"
			>All rights reserved</span
		><slot />
	</div>
</template>
<style>
[data-view-copyright] {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 0.5ch;
	color: var(--ui-text);
	font-size: 0.875rem;
	opacity: 0.7;
}
.copyright-text {
	white-space: nowrap;
}
.rights-text {
	text-transform: capitalize;
}
@media (max-width: 640px) {
	[data-view-copyright] {
		font-size: 0.8rem;
	}
}
</style>
<script setup>
const e = useRoot().querySelector("[data-view-copyright-year]");
if (e) {
	const year = new Date().getFullYear(),
		start = Number(e.textContent.trim());
	e.textContent = start && start < year ? start + "-" + year : String(year);
}
</script>
