<!-- @server ./system/logic/universal_components.go#UniversalComponentData -->
<template>
	<div :id="id" :class="class" data-view-horizontal-menu>
		<nav :aria-label="label" data-view-horizontal-menu-scroll><slot /></nav>
	</div>
</template>
<style>
[data-view-horizontal-menu] {
	position: relative;
	width: 100%;
	scrollbar-width: none;
}
[data-view-horizontal-menu-scroll] {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	overflow-x: auto;
	scrollbar-width: none;
}
[data-view-horizontal-menu-scroll]::-webkit-scrollbar {
	display: none;
}
[data-view-horizontal-menu-scroll] a {
	flex: none;
	padding: 0.5rem 0.75rem;
	border-radius: 0.375rem;
	color: #374151;
	text-decoration: none;
	white-space: nowrap;
	transition:
		background-color 0.2s,
		color 0.2s;
}
[data-view-horizontal-menu-scroll] a:hover {
	background: #f3f4f6;
}
@media (prefers-color-scheme: dark) {
	[data-view-horizontal-menu-scroll] a {
		color: #d1d5db;
	}
	[data-view-horizontal-menu-scroll] a:hover {
		background: #1f2937;
	}
}
</style>
<script setup>
const e = useRoot().querySelector("[data-view-horizontal-menu-scroll]");
if (!e) return;
const wheel = (event) => {
	if (Math.abs(event.deltaY) > Math.abs(event.deltaX)) {
		event.preventDefault();
		e.scrollLeft += event.deltaY;
	}
};
e.addEventListener("wheel", wheel, { passive: false });
onUnmounted(() => e.removeEventListener("wheel", wheel));
</script>
