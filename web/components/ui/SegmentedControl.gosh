<!-- @server ./system/logic/icons.go#UiSegmentedControlData -->
<template>
	<div
		:id="id"
		:class="class"
		:aria-label="segmentedLabel"
		:data-multiple="segmentedMultiple"
		:data-vertical="segmentedVertical"
		:data-full="segmentedFull"
		:data-color="segmentedColor"
		:data-variant="segmentedVariant"
		:data-size="segmentedSize"
		role="group"
		data-ui-segmented-control
	>
		<slot />
	</div>
</template>

<style>
[data-ui-segmented-control] {
	display: inline-flex;
	width: fit-content;
	overflow: hidden;
	border: 1px solid var(--ui-border);
	border-radius: 0.5rem;
	color: var(--ui-text);
	background: var(--ui-control-bg);
}
[data-ui-segmented-control][data-vertical] {
	flex-direction: column;
}
[data-ui-segmented-control][data-full] {
	width: 100%;
}
[data-ui-segmented-control][data-full]:not([data-vertical])
	[data-ui-segmented-control-item] {
	flex: 1;
}
[data-ui-segmented-control-item] {
	position: relative;
	display: inline-flex;
	min-width: 0;
	align-items: center;
	justify-content: center;
	gap: 0.5rem;
	border: 0;
	color: var(--ui-text);
	background: transparent;
	font: inherit;
	font-weight: 600;
	line-height: 1.25;
	cursor: pointer;
	transition:
		color 0.2s ease,
		background-color 0.2s ease;
}
[data-ui-segmented-control-item]:not(:last-child)::after {
	position: absolute;
	top: 20%;
	right: 0;
	width: 1px;
	height: 60%;
	background: color-mix(in srgb, var(--ui-border), transparent 35%);
	content: "";
}
[data-ui-segmented-control][data-vertical]
	[data-ui-segmented-control-item]:not(:last-child)::after {
	top: auto;
	right: 20%;
	bottom: 0;
	width: 60%;
	height: 1px;
}
[data-ui-segmented-control-item]:hover:not(:disabled) {
	background: color-mix(in srgb, var(--ui-text), transparent 93%);
}
[data-ui-segmented-control-item][aria-pressed="true"] {
	color: var(--ui-bg);
	background: var(--ui-text);
}
[data-ui-segmented-control-item]:disabled {
	opacity: 0.45;
	cursor: not-allowed;
}
[data-ui-segmented-control-item]:focus-visible {
	z-index: 1;
	outline: 2px solid var(--ui-focus);
	outline-offset: -2px;
}
[data-ui-segmented-control][data-size="xs"] [data-ui-segmented-control-item] {
	padding: 0.25rem 0.5rem;
	font-size: 0.75rem;
}
[data-ui-segmented-control][data-size="sm"] [data-ui-segmented-control-item] {
	padding: 0.375rem 0.75rem;
	font-size: 0.875rem;
}
[data-ui-segmented-control][data-size="md"] [data-ui-segmented-control-item] {
	padding: 0.5rem 1rem;
	font-size: 0.875rem;
}
[data-ui-segmented-control][data-size="lg"] [data-ui-segmented-control-item] {
	padding: 0.625rem 1.25rem;
	font-size: 1rem;
}
[data-ui-segmented-control][data-color="primary"] {
	border-color: color-mix(in srgb, #4f46e5, var(--ui-border) 35%);
}
[data-ui-segmented-control][data-color="primary"]
	[data-ui-segmented-control-item][aria-pressed="true"] {
	color: #fff;
	background: #4f46e5;
}
[data-ui-segmented-control][data-color="info"]
	[data-ui-segmented-control-item][aria-pressed="true"] {
	color: #fff;
	background: #2563eb;
}
[data-ui-segmented-control][data-color="success"]
	[data-ui-segmented-control-item][aria-pressed="true"] {
	color: #fff;
	background: #059669;
}
[data-ui-segmented-control][data-color="warning"]
	[data-ui-segmented-control-item][aria-pressed="true"] {
	color: #111827;
	background: #f59e0b;
}
[data-ui-segmented-control][data-color="error"]
	[data-ui-segmented-control-item][aria-pressed="true"] {
	color: #fff;
	background: #dc2626;
}
[data-ui-segmented-control][data-variant="soft"] {
	border-color: transparent;
	background: color-mix(in srgb, var(--ui-text), transparent 94%);
}
</style>

<script setup>
const root = useRoot().querySelector("[data-ui-segmented-control]");
if (!root) return;
const items = () =>
	Array.from(root.querySelectorAll("[data-ui-segmented-control-item]"));
const multiple = root.hasAttribute("data-multiple");
const activate = (target) => {
	if (!target || target.disabled) return;
	if (multiple)
		target.setAttribute(
			"aria-pressed",
			String(target.getAttribute("aria-pressed") !== "true"),
		);
	else
		items().forEach((item) =>
			item.setAttribute("aria-pressed", String(item === target)),
		);
	root.dispatchEvent(
		new CustomEvent("ui:segmented-change", {
			bubbles: true,
			detail: {
				value: items()
					.filter(
						(item) => item.getAttribute("aria-pressed") === "true",
					)
					.map((item) => item.dataset.value),
			},
		}),
	);
};
const onClick = (event) =>
	activate(event.target.closest("[data-ui-segmented-control-item]"));
const onKeydown = (event) => {
	if (
		![
			"ArrowRight",
			"ArrowDown",
			"ArrowLeft",
			"ArrowUp",
			"Home",
			"End",
			" ",
			"Enter",
		].includes(event.key)
	)
		return;
	const list = items().filter((item) => !item.disabled),
		current = event.target.closest("[data-ui-segmented-control-item]");
	if (!current) return;
	if (event.key === " " || event.key === "Enter") {
		event.preventDefault();
		activate(current);
		return;
	}
	event.preventDefault();
	let next = list.indexOf(current);
	if (event.key === "Home") next = 0;
	else if (event.key === "End") next = list.length - 1;
	else
		next =
			(next +
				(event.key === "ArrowRight" || event.key === "ArrowDown"
					? 1
					: -1) +
				list.length) %
			list.length;
	list[next].focus();
};
const initial =
	items().find((item) => item.getAttribute("aria-pressed") === "true") ||
	items().find((item) => !item.disabled);
if (initial && !multiple)
	items().forEach((item) =>
		item.setAttribute("aria-pressed", String(item === initial)),
	);
root.addEventListener("click", onClick);
root.addEventListener("keydown", onKeydown);
onUnmounted(() => {
	root.removeEventListener("click", onClick);
	root.removeEventListener("keydown", onKeydown);
});
</script>
