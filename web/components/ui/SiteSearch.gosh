<!-- @server ./system/logic/universal_components.go#UniversalComponentData -->
<template>
	<div
		:id="id"
		:class="class"
		hidden
		aria-hidden="true"
		role="dialog"
		aria-modal="true"
		aria-label="Site search"
		data-ui-site-search
		:data-min-query-length="minQueryLength"
		:data-limit="limit"
		:data-max-pages="maxPages"
		:data-cache-ttl="cacheTtl"
		:data-server-search="serverSearch"
	>
		<div data-site-search-backdrop></div>
		<section data-site-search-panel>
			<header data-site-search-header>
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
					<path
						d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"
					/></svg
				><input
					type="search"
					placeholder="Search the site…"
					autocomplete="off"
					spellcheck="false"
					data-site-search-input
				/><button
					type="button"
					aria-label="Clear search"
					hidden
					data-site-search-clear
				>
					×</button
				><select
					aria-label="Match search words"
					data-site-search-operator
				>
					<option value="and">AND</option>
					<option value="or">OR</option></select
				><kbd>ESC</kbd>
			</header>
			<div data-site-search-body>
				<p data-site-search-status>Preparing site search…</p>
				<ul hidden role="listbox" data-site-search-results></ul>
			</div>
			<footer data-site-search-footer>
				<span data-site-search-count></span><span>↑↓ · Enter</span>
			</footer>
		</section>
	</div>
</template>
<style>
[data-ui-site-search] {
	position: fixed;
	z-index: 99999;
	inset: 0;
	display: flex;
	align-items: flex-start;
	justify-content: center;
	padding: max(1rem, 8dvh) 0.75rem 1rem;
}
[data-site-search-backdrop] {
	position: absolute;
	inset: 0;
	background: rgb(0 0 0/0.45);
	backdrop-filter: blur(2px);
}
[data-site-search-panel] {
	position: relative;
	display: flex;
	width: 100%;
	max-width: 42rem;
	max-height: min(42rem, calc(100dvh - 2rem));
	flex-direction: column;
	overflow: hidden;
	border-radius: 0.75rem;
	color: var(--ui-text);
	background: var(--ui-bg);
	box-shadow: 0 1.5rem 3rem rgb(0 0 0/0.25);
	outline: 1px solid color-mix(in srgb, var(--ui-text), transparent 80%);
}
[data-site-search-header] {
	display: flex;
	min-height: 3.5rem;
	align-items: center;
	gap: 0.75rem;
	padding: 0 1rem;
	border-bottom: 1px solid color-mix(in srgb, var(--ui-text), transparent 90%);
}
[data-site-search-header] svg {
	width: 1.25rem;
	height: 1.25rem;
	flex: none;
	stroke: currentColor;
	stroke-width: 2;
	opacity: 0.45;
}
[data-site-search-input] {
	height: 3.5rem;
	min-width: 0;
	flex: 1;
	border: 0;
	outline: 0;
	color: inherit;
	background: transparent;
	font: inherit;
	font-size: 1rem;
}
[data-site-search-input]::placeholder {
	color: currentColor;
	opacity: 0.35;
}
[data-site-search-clear] {
	display: grid;
	width: 2rem;
	height: 2rem;
	place-items: center;
	border: 0;
	border-radius: 0.375rem;
	color: inherit;
	background: transparent;
	font-size: 1.4rem;
	opacity: 0.5;
	cursor: pointer;
}
[data-site-search-operator] {
	height: 2rem;
	border: 1px solid color-mix(in srgb, var(--ui-text), transparent 85%);
	border-radius: 0.375rem;
	color: inherit;
	background: var(--ui-bg);
	font:
		600 0.6875rem ui-monospace,
		monospace;
}
[data-site-search-header] kbd {
	padding: 0.15rem 0.35rem;
	border: 1px solid color-mix(in srgb, var(--ui-text), transparent 85%);
	border-radius: 0.25rem;
	font:
		0.625rem ui-monospace,
		monospace;
	opacity: 0.45;
}
[data-site-search-body] {
	min-height: 6rem;
	flex: 1;
	overflow-y: auto;
	overscroll-behavior: contain;
	padding: 0.5rem;
}
[data-site-search-status] {
	display: grid;
	min-height: 7rem;
	place-items: center;
	margin: 0;
	padding: 0 1.25rem;
	text-align: center;
	font-size: 0.875rem;
	opacity: 0.5;
}
[data-site-search-results] {
	display: grid;
	gap: 0.125rem;
	margin: 0;
	padding: 0;
	list-style: none;
}
[data-site-search-results] a {
	display: block;
	padding: 0.6rem 0.75rem;
	border-radius: 0.5rem;
	color: inherit;
	text-decoration: none;
}
[data-site-search-results] a:hover,
[data-site-search-results] a[data-selected] {
	background: color-mix(in srgb, var(--ui-text), transparent 90%);
}
[data-site-search-results] strong {
	display: block;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	font-size: 0.875rem;
}
.site-search-snippet {
	display: -webkit-box;
	overflow: hidden;
	margin: 0.25rem 0 0;
	font-size: 0.75rem;
	line-height: 1.4;
	opacity: 0.6;
	-webkit-line-clamp: 1;
	-webkit-box-orient: vertical;
}
.site-search-path {
	display: none;
}
.site-search-mark {
	padding: 0 0.08em;
	border-radius: 0.2em;
	color: inherit;
	background: color-mix(in srgb, var(--ui-primary, #f59e0b) 32%, transparent);
}
[data-site-search-footer] {
	display: flex;
	justify-content: space-between;
	padding: 0.5rem 1rem;
	border-top: 1px solid color-mix(in srgb, var(--ui-text), transparent 90%);
	font-size: 0.6875rem;
	opacity: 0.4;
}
</style>
<script setup>
const root = useRoot().querySelector("[data-ui-site-search]");
if (!root) return;
const input = root.querySelector("[data-site-search-input]"),
	clear = root.querySelector("[data-site-search-clear]"),
	operator = root.querySelector("[data-site-search-operator]"),
	backdrop = root.querySelector("[data-site-search-backdrop]"),
	status = root.querySelector("[data-site-search-status]"),
	list = root.querySelector("[data-site-search-results]"),
	count = root.querySelector("[data-site-search-count]");
if (!input || !clear || !operator || !backdrop || !status || !list || !count)
	return;
const min = Math.max(1, Number(root.dataset.minQueryLength) || 2),
	limit = Math.max(1, Number(root.dataset.limit) || 10),
	maxPages = Math.max(1, Number(root.dataset.maxPages) || 500),
	cacheTtl = Math.max(0, Number(root.dataset.cacheTtl) || 1800000);
let worker,
	ready = false,
	request = 0,
	timer,
	results = [],
	selected = 0;
const lock = (value) => {
	document.documentElement.style.overflow = value ? "hidden" : "";
	document.body.style.overflow = value ? "hidden" : "";
};
const mark = (element, text, query) => {
	const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
	if (!escaped) {
		element.textContent = text;
		return;
	}
	String(text || "")
		.split(new RegExp("(" + escaped + ")", "ig"))
		.forEach((part) => {
			const node =
				part.toLowerCase() === query.toLowerCase()
					? document.createElement("mark")
					: document.createTextNode(part);
			if (node.nodeType === 1) {
				node.className = "site-search-mark";
				node.textContent = part;
			}
			element.append(node);
		});
};
const render = () => {
	list.replaceChildren(
		...results.map((result, index) => {
			const li = document.createElement("li"),
				link = document.createElement("a"),
				title = document.createElement("strong"),
				snippet = document.createElement("p"),
				path = document.createElement("span");
			link.href = result.path;
			if (index === selected) link.dataset.selected = "";
			mark(title, result.title, input.value);
			snippet.className = "site-search-snippet";
			mark(
				snippet,
				result.snippet || result.description || "",
				input.value,
			);
			path.className = "site-search-path";
			path.textContent = result.path;
			link.append(title, snippet, path);
			li.append(link);
			return li;
		}),
	);
	list.hidden = !results.length;
	status.hidden = !!results.length;
	status.textContent = results.length
		? ""
		: input.value
			? "No results."
			: "Type at least " + min + " characters.";
};
const init = () => {
	if (worker) return;
	worker = new Worker(
		window._gosh.siteSearchWorkerURL || "/assets/site-search-worker.js",
	);
	worker.onmessage = (event) => {
		const message = event.data;
		if (message.type === "progress")
			status.textContent =
				"Preparing search: " + message.indexed + " of " + message.total;
		if (message.type === "ready") {
			ready = true;
			count.textContent = "Indexed pages: " + message.count;
			render();
		}
		if (message.type === "results") {
			results = message.results;
			selected = 0;
			render();
		}
		if (message.type === "error") status.textContent = message.message;
	};
	const seeds = [...document.querySelectorAll("a[href]")]
		.map((link) => link.getAttribute("href"))
		.filter((href) => href && href[0] === "/");
	worker.postMessage({
		type: "init",
		requestId: ++request,
		options: {
			origin: location.origin,
			basePath: "/",
			seedUrls: [...new Set(["/", ...seeds])],
			defaultLocale: document.documentElement.lang || "en",
			maxPages: maxPages,
			maxContentLength: 30000,
			cacheTtl: cacheTtl,
			respectNoIndex: true,
		},
	});
};
const open = () => {
	root.hidden = false;
	root.setAttribute("aria-hidden", "false");
	lock(true);
	input.focus();
	init();
};
const close = () => {
	root.hidden = true;
	root.setAttribute("aria-hidden", "true");
	lock(false);
};
const search = () => {
	const query = input.value.trim();
	clear.hidden = !query;
	if (ready && query.length >= min)
		worker.postMessage({
			type: "search",
			requestId: ++request,
			query: query,
			locale: document.documentElement.lang || "en",
			allLocales: false,
			operator: operator.value,
			limit: limit,
		});
	else {
		results = [];
		render();
	}
};
const key = (event) => {
	if (!root.hidden && event.key === "Escape") close();
};
input.addEventListener("input", () => {
	clearTimeout(timer);
	timer = setTimeout(search, 100);
});
clear.addEventListener("click", () => {
	input.value = "";
	search();
	input.focus();
});
operator.addEventListener("change", search);
backdrop.addEventListener("click", close);
document.addEventListener("gosh:site-search-open", open);
document.addEventListener("keydown", key);
onUnmounted(() => {
	clearTimeout(timer);
	lock(false);
	worker && worker.terminate();
	document.removeEventListener("gosh:site-search-open", open);
	document.removeEventListener("keydown", key);
});
</script>
