<script setup>
const root = useRoot().querySelector("[data-ui-modal]");
if (!root) return;
const store = useStore("ui"),
	key = root.id,
	parent = root.parentNode,
	next = root.nextSibling,
	card = root.querySelector("[data-ui-modal-card]"),
	button = root.querySelector("[data-ui-modal-close]"),
	backdrop = root.querySelector("[data-ui-modal-backdrop]");
let focus,
	locked = false;
document.body.append(root);
const unlock = () => {
	if (!locked) return;
	document.documentElement.style.overflow = "";
	document.body.style.overflow = "";
	locked = false;
};
const close = () => {
	if (root.hidden) return;
	delete root.dataset.open;
	root.setAttribute("aria-hidden", "true");
	setTimeout(() => {
		if (!root.hasAttribute("data-open")) root.hidden = true;
	}, 200);
	unlock();
	store && store.getState().closeModal();
	if (focus && focus.focus) focus.focus();
	focus = null;
};
const open = () => {
	if (!root.hidden) return;
	focus = document.activeElement;
	root.hidden = false;
	root.setAttribute("aria-hidden", "false");
	document.documentElement.style.overflow = "hidden";
	document.body.style.overflow = "hidden";
	locked = true;
	requestAnimationFrame(() => {
		root.dataset.open = "";
		card.focus();
	});
};
const render = () => {
	if (store && store.getState().modal === key) open();
	else close();
};
const outside = (e) => {
	if (e.target === backdrop) close();
};
const keydown = (e) => {
	if (e.key === "Escape") close();
};
button && button.addEventListener("click", close);
backdrop.addEventListener("click", outside);
document.addEventListener("keydown", keydown);
const unsubscribe = store && store.subscribe(render);
render();
onUnmounted(() => {
	unlock();
	button && button.removeEventListener("click", close);
	backdrop.removeEventListener("click", outside);
	document.removeEventListener("keydown", keydown);
	unsubscribe && unsubscribe();
	if (parent) parent.insertBefore(root, next);
});
</script>
