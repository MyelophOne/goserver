<!-- @server ./system/logic/universal_components.go#UniversalComponentData -->
<template>
	<dialog
		:id="id"
		:class="class"
		aria-label="Command palette"
		data-ui-command-palette
		:data-items-json="itemsJson"
	>
		<div data-ui-command-shell>
			<div data-ui-command-search-wrap>
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
					<path
						d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"
					/></svg
				><input
					type="search"
					:placeholder="placeholder"
					autocomplete="off"
					spellcheck="false"
					data-ui-command-search
				/><kbd>ESC</kbd>
			</div>
			<div data-ui-command-list role="listbox"></div>
		</div>
	</dialog>
</template>
<style>
[data-ui-command-palette] {
	width: min(42rem, calc(100vw - 2rem));
	max-height: calc(100dvh - 2rem);
	margin: auto;
	padding: 0;
	overflow: hidden;
	border: 1px solid color-mix(in srgb, var(--ui-text), transparent 80%);
	border-radius: 0.75rem;
	color: var(--ui-text);
	background: var(--ui-bg);
	box-shadow: 0 1.5rem 4rem rgb(0 0 0/0.35);
}
[data-ui-command-palette]::backdrop {
	background: rgb(0 0 0/0.45);
	backdrop-filter: blur(2px);
}
[data-ui-command-shell] {
	display: flex;
	max-height: inherit;
	flex-direction: column;
	overflow: hidden;
}
[data-ui-command-search-wrap] {
	display: flex;
	min-height: 3.5rem;
	align-items: center;
	gap: 0.75rem;
	padding: 0 1rem;
	border-bottom: 1px solid color-mix(in srgb, var(--ui-text), transparent 90%);
}
[data-ui-command-search-wrap] svg {
	width: 1.25rem;
	height: 1.25rem;
	flex: none;
	stroke: currentColor;
	stroke-width: 2;
	opacity: 0.45;
}
[data-ui-command-search] {
	min-width: 0;
	flex: 1;
	border: 0;
	outline: 0;
	color: inherit;
	background: transparent;
	font: inherit;
	font-size: 1rem;
}
[data-ui-command-search]::placeholder {
	color: currentColor;
	opacity: 0.35;
}
[data-ui-command-search-wrap] kbd {
	padding: 0.15rem 0.35rem;
	border: 1px solid color-mix(in srgb, var(--ui-text), transparent 82%);
	border-radius: 0.25rem;
	font:
		0.65rem ui-monospace,
		monospace;
	opacity: 0.5;
}
[data-ui-command-list] {
	min-height: 6rem;
	max-height: min(30rem, calc(100dvh - 7rem));
	overflow: auto;
	padding: 0.5rem;
}
[data-ui-command-list] button {
	display: block;
	width: 100%;
	padding: 0.75rem;
	border: 0;
	border-radius: 0.5rem;
	color: inherit;
	background: transparent;
	text-align: left;
	font: inherit;
	cursor: pointer;
}
[data-ui-command-list] button:hover,
[data-ui-command-list] button:focus-visible {
	background: color-mix(in srgb, var(--ui-text), transparent 93%);
	outline: 0;
}
[data-ui-command-list] small {
	display: block;
	margin-top: 0.2rem;
	opacity: 0.5;
}
</style>
<script setup>
const root = useRoot().querySelector("[data-ui-command-palette]");
if (!root) return;
const input = root.querySelector("[data-ui-command-search]"),
	list = root.querySelector("[data-ui-command-list]"),
	preferences = useStore("preferences");
if (!input || !list) return;
let items = [];
try {
	items = JSON.parse(root.dataset.itemsJson || "[]");
} catch (_) {}
const close = () => {
	if (root.open) root.close();
};
const execute = (item) => {
	if (item.path) {
		location.assign(item.path);
		return;
	}
	if (item.action === "preferences.setTheme" && preferences)
		preferences
			.getState()
			.setTheme(...(Array.isArray(item.args) ? item.args : []));
	close();
};
const draw = () => {
	const query = input.value.trim().toLowerCase();
	const shown = items.filter(
		(item) =>
			!query ||
			[item.name, item.hint, ...(item.keywords || [])]
				.join(" ")
				.toLowerCase()
				.includes(query),
	);
	list.replaceChildren(
		...shown.map((item) => {
			const button = document.createElement("button");
			button.type = "button";
			button.dataset.command = "";
			button.textContent = item.name || item.id || "";
			if (item.hint) {
				const hint = document.createElement("small");
				hint.textContent = item.hint;
				button.append(hint);
			}
			button.addEventListener("click", () => execute(item));
			return button;
		}),
	);
};
const open = () => {
	if (!root.open) root.showModal();
	input.value = "";
	draw();
	input.focus();
};
const key = (event) => {
	if (event.key === "Escape") close();
};
input.addEventListener("input", draw);
root.addEventListener("close", () => {
	input.value = "";
});
document.addEventListener("gosh:command-palette-open", open);
document.addEventListener("keydown", key);
onUnmounted(() => {
	input.removeEventListener("input", draw);
	document.removeEventListener("gosh:command-palette-open", open);
	document.removeEventListener("keydown", key);
});
</script>
