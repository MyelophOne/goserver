	--banner-border: #ef4444;
}
</style>

<script setup>
const root = useRoot().querySelector("[data-ui-banner]");
const close = root && root.querySelector("[data-ui-banner-close]");
if (!root || !close) return;
const onClose = () => {
	root.hidden = true;
	root.dispatchEvent(
		new CustomEvent("ui:banner-close", {
			bubbles: true,
			detail: { banner: root },
		}),
	);
};
close.addEventListener("click", onClose);
onUnmounted(() => close.removeEventListener("click", onClose));
</script>
