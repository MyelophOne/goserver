	--banner-bg: #f3f4f6;
	--banner-text: #111827;
	--banner-border: #d1d5db;
	display: flex;
	width: 100%;
	align-items: center;
	gap: 1rem;
	padding: 0.75rem 1rem;
	border: 1px solid transparent;
	background: var(--banner-bg);
	color: var(--banner-text);
}
