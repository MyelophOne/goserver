}
.ui-banner-icon {
	display: inline-flex;
	width: 1.5rem;
	height: 1.5rem;
}
.ui-banner-avatar-icon gosh-component,
.ui-banner-avatar-icon [data-ui-icon],
.ui-banner-icon gosh-component,
.ui-banner-icon [data-ui-icon] {
	display: block;
	width: 100%;
	height: 100%;
}
[data-ui-banner-copy] {
	display: flex;
	min-width: 0;
	flex: 1;
	flex-direction: column;
