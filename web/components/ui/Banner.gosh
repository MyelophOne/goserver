	--banner-bg: #d1fae5;
	--banner-text: #065f46;
	--banner-border: #34d399;
}
[data-ui-banner][data-color="success"][data-variant="solid"] {
	--banner-bg: #059669;
	--banner-text: #fff;
}
[data-ui-banner][data-color="warning"] {
	--banner-bg: #fef3c7;
	--banner-text: #92400e;
	--banner-border: #fbbf24;
}
[data-ui-banner][data-color="warning"][data-variant="solid"] {
	--banner-bg: #d97706;
