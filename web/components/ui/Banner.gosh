}
[data-ui-banner-close] {
	display: inline-grid;
	width: 1.75rem;
	height: 1.75rem;
	flex: none;
	place-items: center;
	border: 0;
	border-radius: 0.375rem;
	background: transparent;
	color: currentColor;
	font-size: 1.4rem;
	line-height: 1;
	opacity: 0.6;
	cursor: pointer;
	transition:
		opacity 0.15s ease,
		background-color 0.15s ease;
}
[data-ui-banner-close]:hover {
	background: color-mix(in srgb, currentColor, transparent 92%);
	opacity: 1;
}
[data-ui-banner-close]:focus-visible {
	outline: 2px solid currentColor;
	outline-offset: 2px;
}
[data-theme="dark"] [data-ui-banner][data-color="gray"] {
	--banner-bg: #1f2937;
	--banner-text: #f9fafb;
	--banner-border: #4b5563;
}
[data-theme="dark"] [data-ui-banner][data-color="primary"] {
	--banner-bg: #312e81;
	--banner-text: #e0e7ff;
	--banner-border: #6366f1;
}
[data-theme="dark"] [data-ui-banner][data-color="info"] {
	--banner-bg: #1e3a8a;
	--banner-text: #dbeafe;
	--banner-border: #3b82f6;
}
[data-theme="dark"] [data-ui-banner][data-color="success"] {
	--banner-bg: #064e3b;
	--banner-text: #d1fae5;
	--banner-border: #10b981;
}
[data-theme="dark"] [data-ui-banner][data-color="warning"] {
	--banner-bg: #78350f;
	--banner-text: #fef3c7;
	--banner-border: #f59e0b;
}
[data-theme="dark"] [data-ui-banner][data-color="error"] {
	--banner-bg: #7f1d1d;
