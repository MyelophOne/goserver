<!-- @server ./system/logic/icons.go#UiBannerData -->
<template>
	<div
		:id="id"
		:class="class"
		role="region"
		:data-color="bannerColor"
		:data-variant="bannerVariant"
		:data-rounded="bannerRounded"
		:data-bordered="bannerBordered"
		data-ui-banner
	>
		<div m-if="bannerHasMedia" data-ui-banner-media>
			<img
				m-if="bannerAvatarSrc"
				:src="bannerAvatarSrc"
				:alt="bannerAvatarAlt"
				loading="lazy"
				data-ui-banner-avatar-image
			/>
			<UiIcon
				m-if="bannerAvatarIcon"
				:name="bannerAvatarIcon"
				class="ui-banner-avatar-icon"
			/>
			<UiIcon
				m-if="!bannerHasAvatar && bannerIcon"
				:name="bannerIcon"
				class="ui-banner-icon"
			/>
		</div>
		<div data-ui-banner-copy>
			<div m-if="bannerHasTitle" data-ui-banner-title>
				{{ bannerTitle }}
			</div>
			<div m-if="bannerHasDescription" data-ui-banner-description>
				{{ bannerDescription }}
			</div>
			<slot />
		</div>
		<button
			m-if="bannerClosable"
			type="button"
			aria-label="Close banner"
			data-ui-banner-close
		>
			<span aria-hidden="true">×</span>
		</button>
	</div>
</template>

<style scoped>
