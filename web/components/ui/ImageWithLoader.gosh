<template>
	<div class="lazy-image-wrapper" data-ui-image-loader>
		<img
			:id="id"
			:class="imgClass"
			:alt="alt"
			:width="width"
			:height="height"
			:sizes="sizes"
			:data-ui-image-src="src"
			:data-ui-image-fallback="fallbackSrc"
			:loading="loading"
			:decoding="decoding"
			:fetchpriority="fetchpriority"
			data-ui-image
		/>
		<div class="loaderparent imgpreloader" aria-hidden="true">
			<svg
				width="26"
				height="26"
				viewBox="0 0 32 32"
				xmlns="http://www.w3.org/2000/svg"
				class="loadersvg"
			>
				<g fill="none" fill-rule="evenodd">
					<g fill="var(--loader-fill-color, #333)">
						<path
							d="M16 32a16 16 0 110-32 16 16 0 010 32zm0-2a14 14 0 100-28 14 14 0 000 28z"
							fill-rule="nonzero"
							opacity=".1"
						/>
						<path d="M16 2V0A16 16 0 000 16h2A14 14 0 0116 2z" />
					</g>
				</g>
			</svg>
		</div>
		<noscript
			><img
				:id="id"
				:class="imgClass"
				:src="src"
				:alt="alt"
				:width="width"
				:height="height"
				:sizes="sizes"
				:loading="loading"
				:decoding="decoding"
				:fetchpriority="fetchpriority"
		/></noscript>
	</div>
</template>

<script setup>
var wrapper = useRoot().querySelector("[data-ui-image-loader]");
if (!wrapper) return;
var image = wrapper.querySelector("img[data-ui-image-src]");
if (!image) return;

var reveal = function () {
	var source = image.getAttribute("data-ui-image-src");
	if (!source) {
		wrapper.classList.add("image-loaded");
		return;
	}
	if (image.getAttribute("src")) return;
	image.setAttribute("src", source);
};
var onLoad = function () {
	image.classList.add("image-visible");
	wrapper.classList.add("image-loaded");
};
var onError = function () {
	var fallback = image.getAttribute("data-ui-image-fallback");
	if (fallback && image.getAttribute("src") !== fallback) {
		image.setAttribute("src", fallback);
		return;
	}
	wrapper.classList.add("image-loaded");
};

image.addEventListener("load", onLoad);
image.addEventListener("error", onError);
if (typeof IntersectionObserver !== "function") {
	reveal();
} else {
	var observer = new IntersectionObserver(
		function (entries) {
			if (!entries[0] || !entries[0].isIntersecting) return;
			observer.disconnect();
			reveal();
		},
		{ rootMargin: "100px", threshold: 0.1 },
	);
	observer.observe(wrapper);
}
return function () {
	image.removeEventListener("load", onLoad);
	image.removeEventListener("error", onError);
	if (typeof observer !== "undefined") observer.disconnect();
};
</script>

<style scoped>
.lazy-image-wrapper {
	position: relative;
	display: block;
	width: 100%;
	height: 100%;
	overflow: hidden;
}
img[data-ui-image] {
	position: absolute;
	inset: 0;
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
	opacity: 0;
	transition: opacity 0.4s ease-in-out;
	z-index: 2;
}
img[data-ui-image].image-visible {
	opacity: 1;
}
.loaderparent {
	position: absolute;
	inset: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 1;
	background: transparent;
}
.image-loaded .loaderparent {
	display: none;
}
</style>
