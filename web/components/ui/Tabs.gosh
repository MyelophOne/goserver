<!-- @server ./system/logic/icons.go#UiTabsData -->
<template>
	<div
		:id="id"
		:class="class"
		:style="tabsWidthStyle"
		:data-orientation="tabsOrientation"
		:data-side="tabsSide"
		:data-tab-width="tabsTabWidth"
		:data-align="tabsAlign"
		:data-loop="tabsLoop"
		:data-stack-mobile="tabsStackOnMobile"
		:data-aria-label="tabsAriaLabel"
		data-ui-tabs
	>
		<div
			:aria-label="tabsAriaLabel"
			:aria-orientation="tabsOrientation"
			role="tablist"
			data-ui-tabs-list
		>
			<slot />
		</div>
	</div>
</template>

<style>
[data-ui-tabs] {
	display: flex;
	width: 100%;
	min-width: 0;
	gap: 1.5rem;
	color: var(--ui-text);
}
[data-ui-tabs][data-orientation="horizontal"] {
	flex-direction: column;
	gap: 1rem;
}
[data-ui-tabs][data-side="right"] [data-ui-tabs-list],
[data-ui-tabs][data-side="bottom"] [data-ui-tabs-list] {
	order: 2;
}
[data-ui-tabs-list] {
	display: flex;
	flex: 0 0 var(--ui-tabs-list-width);
	min-width: 0;
	gap: 0.4rem;
}
[data-ui-tabs][data-orientation="vertical"] [data-ui-tabs-list] {
	width: var(--ui-tabs-list-width);
	flex-direction: column;
}
[data-ui-tabs][data-orientation="horizontal"] [data-ui-tabs-list] {
	width: 100%;
	flex: none;
	flex-flow: row wrap;
}
[data-ui-tabs][data-align="start"] [data-ui-tabs-list] {
	align-items: flex-start;
	justify-content: flex-start;
}
[data-ui-tabs][data-align="center"] [data-ui-tabs-list] {
	align-items: center;
	justify-content: center;
}
[data-ui-tabs][data-align="end"] [data-ui-tabs-list] {
	align-items: flex-end;
	justify-content: flex-end;
}
[data-ui-tabs-list] > gosh-component {
	display: block;
	min-width: 0;
}
[data-ui-tabs][data-tab-width="full"][data-orientation="vertical"]
	[data-ui-tabs-list]
	> gosh-component {
	width: 100%;
}
[data-ui-tabs][data-tab-width="full"][data-orientation="horizontal"]
	[data-ui-tabs-list]
	> gosh-component {
	flex: 1 1 0;
}
[data-ui-tab-button] {
	width: 100%;
	min-height: 2.65rem;
	padding: 0.65rem 0.85rem;
	border: 1px solid transparent;
	border-radius: 0.5rem;
	background: transparent;
	color: var(--ui-text);
	font: inherit;
	font-size: 0.9rem;
	font-weight: 600;
	line-height: 1.25;
	text-align: inherit;
	cursor: pointer;
	transition:
		color 0.14s ease,
		background-color 0.14s ease,
		border-color 0.14s ease;
}
[data-ui-tabs][data-align="start"] [data-ui-tab-button] {
	text-align: start;
}
[data-ui-tabs][data-align="center"] [data-ui-tab-button] {
	text-align: center;
}
[data-ui-tabs][data-align="end"] [data-ui-tab-button] {
	text-align: end;
}
[data-ui-tab-button]:hover:not(:disabled) {
	background: color-mix(in srgb, var(--ui-text), transparent 95%);
}
[data-ui-tab][data-active] [data-ui-tab-button] {
	border-color: color-mix(in srgb, var(--ui-text), transparent 84%);
	background: color-mix(in srgb, var(--ui-text), transparent 90%);
}
[data-ui-tab-button]:focus-visible {
	outline: 2px solid var(--ui-focus, #2563eb);
	outline-offset: 2px;
}
[data-ui-tab-button]:disabled {
	cursor: not-allowed;
	opacity: 0.4;
}
[data-ui-tabs-panel-wrap] {
	min-width: 0;
	flex: 1 1 auto;
}
[data-ui-tab-panel] {
	min-width: 0;
	outline: none;
	animation: ui-tabs-panel-in 0.16s ease;
}
[data-ui-tab-panel]:focus-visible {
	outline: 2px solid var(--ui-focus, #2563eb);
	outline-offset: 0.35rem;
}
@keyframes ui-tabs-panel-in {
	from {
		opacity: 0;
		transform: translate(0.4rem, 0.25rem);
	}
	to {
		opacity: 1;
		transform: none;
	}
}
@media (max-width: 767px) {
	[data-ui-tabs][data-orientation="vertical"][data-stack-mobile] {
		flex-direction: column;
		gap: 1rem;
	}
	[data-ui-tabs][data-orientation="vertical"][data-stack-mobile]
		[data-ui-tabs-list] {
		order: 0;
		width: 100%;
		flex: none;
		flex-flow: row nowrap;
		overflow-x: auto;
	}
	[data-ui-tabs][data-orientation="vertical"][data-stack-mobile][data-tab-width="full"]
		[data-ui-tabs-list]
		> gosh-component {
		width: auto;
		flex: 1 0 auto;
	}
}
@media (prefers-reduced-motion: reduce) {
	[data-ui-tab-button],
	[data-ui-tab-panel] {
		animation: none;
		transition: none;
	}
}
</style>

<script setup>
const root = useRoot().querySelector("[data-ui-tabs]");
const list = root && root.querySelector("[data-ui-tabs-list]");
if (!root || !list) return;
const tabs = Array.from(root.querySelectorAll("[data-ui-tab]"));
if (!tabs.length) return;
const panelWrap = document.createElement("div");
panelWrap.dataset.uiTabsPanelWrap = "";
root.append(panelWrap);
const base = root.id || "ui-tabs-" + Math.random().toString(36).slice(2, 8);
root.id = base;
const items = tabs.map((item, index) => {
	const button = item.querySelector("[data-ui-tab-button]"),
		panel = item.querySelector("[data-ui-tab-panel]");
	button.id = base + "-tab-" + index;
	panel.id = base + "-panel-" + index;
	button.setAttribute("aria-controls", panel.id);
	panel.setAttribute("aria-labelledby", button.id);
	panelWrap.append(panel);
	return {
		item,
		button,
		panel,
		disabled: item.hasAttribute("data-disabled"),
	};
});
const enabled = () => items.filter((entry) => !entry.disabled);
let active = items.findIndex(
	(entry) => entry.item.hasAttribute("data-active") && !entry.disabled,
);
if (active < 0) active = items.findIndex((entry) => !entry.disabled);
const select = (index, focus) => {
	const entry = items[index];
	if (!entry || entry.disabled) return;
	active = index;
	items.forEach((current, currentIndex) => {
		const selected = currentIndex === active;
		current.item.toggleAttribute("data-active", selected);
		current.button.tabIndex = selected ? 0 : -1;
		current.button.setAttribute("aria-selected", String(selected));
		current.panel.hidden = !selected;
	});
	if (focus) entry.button.focus();
	root.dispatchEvent(
		new CustomEvent("ui:tabs-change", {
			bubbles: true,
			detail: { index: active, tab: entry.item },
		}),
	);
};
const move = (direction) => {
	const available = enabled(),
		current = available.indexOf(items[active]);
	if (current < 0) return;
	let next = current + direction;
	if (root.hasAttribute("data-loop"))
		next = (next + available.length) % available.length;
	else next = Math.max(0, Math.min(next, available.length - 1));
	select(items.indexOf(available[next]), true);
};
const onKeydown = (event) => {
	const vertical = root.dataset.orientation === "vertical";
	if (event.key === (vertical ? "ArrowUp" : "ArrowLeft")) {
		event.preventDefault();
		move(-1);
	} else if (event.key === (vertical ? "ArrowDown" : "ArrowRight")) {
		event.preventDefault();
		move(1);
	} else if (event.key === "Home") {
		event.preventDefault();
		select(items.indexOf(enabled()[0]), true);
	} else if (event.key === "End") {
		event.preventDefault();
		const available = enabled();
		select(items.indexOf(available[available.length - 1]), true);
	}
};
const listeners = items.map((entry, index) => {
	const click = () => select(index, false);
	entry.button.addEventListener("click", click);
	entry.button.addEventListener("keydown", onKeydown);
	return () => {
		entry.button.removeEventListener("click", click);
		entry.button.removeEventListener("keydown", onKeydown);
	};
});
if (active >= 0) select(active, false);
onUnmounted(() => {
	listeners.forEach((remove) => remove());
	items.forEach((entry) => entry.item.append(entry.panel));
	panelWrap.remove();
});
</script>
