<!-- @server ./system/logic/cookies.go#ConsentGoogleMapData -->
<template>
	<div data-consent-google-map>
		<CookieConsentWrapper category="functional" service-name="Google Maps">
			<iframe
				m-if="consentMapHasQuery"
				:src="consentMapSrc"
				:title="consentMapTitle"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen
			></iframe>
			<div m-else data-consent-google-map-empty>
				Google Maps address is not configured.
			</div>
		</CookieConsentWrapper>
	</div>
</template>
<style>
[data-consent-google-map] {
	width: 100%;
	height: 25rem;
}
[data-consent-google-map] iframe {
	width: 100%;
	height: 100%;
	border: 0;
	border-radius: 0.75rem;
}
[data-consent-google-map-empty] {
	display: grid;
	height: 100%;
	place-items: center;
	border-radius: 0.75rem;
	background: var(--ui-control-bg, #f3f4f6);
}
</style>
